# =============================================================================
# ASTRA environment template — copy to `.env` and fill in YOUR values there.
#   copy .env.example .env        (Windows)
# This file is committed to git, so keep it free of real secrets.
# =============================================================================

# development (local) | production (later, for deployment)
ASTRA_ENV=development

# Long random string used to sign session cookies:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# --- Database: Turso (libSQL) ------------------------------------------------
# Looks like: libsql://astra-<your-org>.turso.io
# REQUIRED — ASTRA stores all data in Turso and will not start its pages without it.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
TURSO_DRIVER=http
SEED_SAMPLE_DATA=true

# --- Administrator (single account) -------------------------------------------
ADMIN_USERNAME=
# Generate with: python scripts/hash_password.py   (wrap in single quotes)
ADMIN_PASSWORD_HASH=
# Optional plain-text alternative for local experiments only (ignored when a hash is set)
ADMIN_PASSWORD=
ADMIN_LOGIN_PATH=gate
SESSION_LIFETIME_HOURS=8
SESSION_IDLE_MINUTES=120
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15

# --- Google Gemini (https://aistudio.google.com/apikey) -----------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Comma-separated chain tried in order when the primary is overloaded or unavailable.
# (ASTRA always appends gemini-flash-latest and gemini-flash-lite-latest as last resorts.)
GEMINI_FALLBACK_MODEL=gemini-3.7-flash,gemini-flash-latest
GEMINI_PUBLIC_MODEL=
GEMINI_TIMEOUT_SECONDS=60
EMBEDDINGS_PROVIDER=gemini
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768

# --- Public chatbot limits ------------------------------------------------------
PUBLIC_CHAT_PER_IP_10MIN=12
PUBLIC_CHAT_PER_IP_DAY=60
PUBLIC_CHAT_GLOBAL_DAY=600
PUBLIC_CHAT_MAX_CHARS=600

MAX_UPLOAD_MB=4
LOG_LEVEL=INFO
